# Среда разработки
.idea/
.venv/
.venv-*/
venv/

# Кэш Python
__pycache__/
*.py[cod]

# Рабочие настройки пользователя: создаются из settings.example.json при первом запуске
settings.json

# Анимации состояний рисует create_dragon_gifs.py при первом запуске
